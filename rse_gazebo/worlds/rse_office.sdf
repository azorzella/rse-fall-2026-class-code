<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rse_office">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.62 0.62 0.62 1</ambient>
      <background>0.86 0.90 0.94 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="office_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry>
          <material><ambient>0.72 0.72 0.70 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A central east-west hallway connects six rooms. Doorways are 1.4 m wide. -->
    <model name="office_walls">
      <static>true</static>

      <!-- Exterior walls. -->
      <link name="north_wall">
        <pose>0 7.9 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>20 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 1.4</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>0 -7.9 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>20 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 1.4</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      </link>
      <link name="east_wall">
        <pose>9.9 0 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 16 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 16 1.4</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      </link>
      <link name="west_wall">
        <pose>-9.9 0 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 16 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 16 1.4</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      </link>

      <!-- North hallway wall, split around three doorways. -->
      <link name="north_hall_1">
        <pose>-8.3 1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.2 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.2 1.4</size></box></geometry><material><ambient>0.70 0.78 0.86 1</ambient><diffuse>0.70 0.78 0.86 1</diffuse></material></visual>
      </link>
      <link name="north_hall_2">
        <pose>-3.0 1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.6 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.6 0.2 1.4</size></box></geometry><material><ambient>0.70 0.78 0.86 1</ambient><diffuse>0.70 0.78 0.86 1</diffuse></material></visual>
      </link>
      <link name="north_hall_3">
        <pose>3.0 1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.6 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.6 0.2 1.4</size></box></geometry><material><ambient>0.70 0.78 0.86 1</ambient><diffuse>0.70 0.78 0.86 1</diffuse></material></visual>
      </link>
      <link name="north_hall_4">
        <pose>8.3 1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.2 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.2 1.4</size></box></geometry><material><ambient>0.70 0.78 0.86 1</ambient><diffuse>0.70 0.78 0.86 1</diffuse></material></visual>
      </link>

      <!-- South hallway wall, with doorways deliberately offset from the north side. -->
      <link name="south_hall_1">
        <pose>-8.55 -1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.7 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.7 0.2 1.4</size></box></geometry><material><ambient>0.86 0.77 0.67 1</ambient><diffuse>0.86 0.77 0.67 1</diffuse></material></visual>
      </link>
      <link name="south_hall_2">
        <pose>-3.5 -1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.6 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.6 0.2 1.4</size></box></geometry><material><ambient>0.86 0.77 0.67 1</ambient><diffuse>0.86 0.77 0.67 1</diffuse></material></visual>
      </link>
      <link name="south_hall_3">
        <pose>3.0 -1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.6 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.6 0.2 1.4</size></box></geometry><material><ambient>0.86 0.77 0.67 1</ambient><diffuse>0.86 0.77 0.67 1</diffuse></material></visual>
      </link>
      <link name="south_hall_4">
        <pose>8.55 -1.4 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.7 0.2 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.7 0.2 1.4</size></box></geometry><material><ambient>0.86 0.77 0.67 1</ambient><diffuse>0.86 0.77 0.67 1</diffuse></material></visual>
      </link>

      <!-- Room dividers. -->
      <link name="north_divider_west">
        <pose>-3.5 4.65 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.5 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.5 1.4</size></box></geometry><material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      </link>
      <link name="north_divider_east">
        <pose>3.5 4.65 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.5 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.5 1.4</size></box></geometry><material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      </link>
      <link name="south_divider_west">
        <pose>-4.0 -4.65 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.5 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.5 1.4</size></box></geometry><material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      </link>
      <link name="south_divider_east">
        <pose>3.0 -4.65 0.7 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6.5 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.5 1.4</size></box></geometry><material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Distinctive furniture reduces symmetry and creates useful costmap obstacles. -->
    <model name="office_furniture">
      <static>true</static>
      <link name="northwest_desk">
        <pose>-6.7 5.5 0.45 0 0 0.18</pose>
        <collision name="collision"><geometry><box><size>2.2 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.8 0.9</size></box></geometry><material><ambient>0.45 0.27 0.12 1</ambient><diffuse>0.55 0.34 0.16 1</diffuse></material></visual>
      </link>
      <link name="conference_table">
        <pose>0 5.0 0.42 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.6 1.4 0.84</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.6 1.4 0.84</size></box></geometry><material><ambient>0.34 0.22 0.14 1</ambient><diffuse>0.46 0.30 0.18 1</diffuse></material></visual>
      </link>
      <link name="northeast_bench_1">
        <pose>6.4 3.2 0.45 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.0 0.65 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.65 0.9</size></box></geometry><material><ambient>0.25 0.35 0.48 1</ambient><diffuse>0.30 0.42 0.58 1</diffuse></material></visual>
      </link>
      <link name="northeast_bench_2">
        <pose>7.8 6.2 0.45 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>2.4 0.65 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.65 0.9</size></box></geometry><material><ambient>0.25 0.35 0.48 1</ambient><diffuse>0.30 0.42 0.58 1</diffuse></material></visual>
      </link>
      <link name="southwest_desk_1">
        <pose>-7.3 -4.0 0.45 0 0 -0.12</pose>
        <collision name="collision"><geometry><box><size>2.0 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.8 0.9</size></box></geometry><material><ambient>0.46 0.30 0.18 1</ambient><diffuse>0.58 0.38 0.22 1</diffuse></material></visual>
      </link>
      <link name="breakroom_counter">
        <pose>-0.6 -6.7 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.4 0.7 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.4 0.7 1.0</size></box></geometry><material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.62 0.65 0.68 1</diffuse></material></visual>
      </link>
      <link name="breakroom_table">
        <pose>-0.5 -3.8 0.38 0 0 0.35</pose>
        <collision name="collision"><geometry><cylinder><radius>0.75</radius><length>0.76</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.75</radius><length>0.76</length></cylinder></geometry><material><ambient>0.56 0.36 0.18 1</ambient><diffuse>0.66 0.45 0.24 1</diffuse></material></visual>
      </link>
      <link name="storage_shelf_1">
        <pose>4.4 -5.2 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 3.8 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 3.8 1.8</size></box></geometry><material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.36 0.38 0.42 1</diffuse></material></visual>
      </link>
      <link name="storage_shelf_2">
        <pose>7.0 -5.2 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 3.8 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 3.8 1.8</size></box></geometry><material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.36 0.38 0.42 1</diffuse></material></visual>
      </link>
      <link name="hall_kiosk">
        <pose>1.8 0.35 0.55 0 0 0.25</pose>
        <collision name="collision"><geometry><box><size>0.65 0.65 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 0.65 1.1</size></box></geometry><material><ambient>0.78 0.25 0.12 1</ambient><diffuse>0.88 0.32 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <model name="room_markers">
      <static>true</static>
      <link name="start_pad">
        <pose>-8.4 0 0.012 0 0 0</pose>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.024</size></box></geometry><material><ambient>0.12 0.36 0.92 1</ambient><diffuse>0.12 0.36 0.92 1</diffuse></material></visual>
      </link>
      <link name="conference_pad">
        <pose>0 2.6 0.012 0 0 0</pose>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.024</size></box></geometry><material><ambient>0.12 0.72 0.28 1</ambient><diffuse>0.12 0.72 0.28 1</diffuse></material></visual>
      </link>
      <link name="storage_pad">
        <pose>8.2 -2.7 0.012 0 0 0</pose>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.024</size></box></geometry><material><ambient>0.94 0.45 0.08 1</ambient><diffuse>0.94 0.45 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- AprilTag 36h11, ID 0.
         Mounted on the west face of the conference-room east wall. -->
    <include>
      <uri>model://apriltag_0</uri>
      <name>conference_apriltag_0</name>

      <!--
           east divider wall center: x = 3.5
           wall thickness: 0.2 m
           west face: x = 3.4

           Move 1 cm into the room to avoid z-fighting.
           Model's tag normal is +X, so yaw=pi makes it face west (-X).
      -->
      <pose>3.39 3.8 1.0 0 0 3.14159265</pose>
    </include>
    <include>
      <uri>model://rse_bot</uri>
      <name>rse_bot</name>
      <pose>-8.4 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>

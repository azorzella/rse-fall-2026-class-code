<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rse_bot" canonical_link="base_link">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>7.0</mass>
        <inertia>
          <ixx>0.065</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.105</iyy><iyz>0</iyz><izz>0.145</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.42 0.30 0.10</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.42 0.30 0.10</size></box></geometry>
        <material>
          <ambient>0.10 0.28 0.72 1</ambient>
          <diffuse>0.12 0.34 0.90 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <!-- Bright wedge-like front marker: the robot's +X direction. -->
      <visual name="front_marker">
        <pose>0.215 0 0.035 0 0 0</pose>
        <geometry><box><size>0.03 0.20 0.045</size></box></geometry>
        <material>
          <ambient>1.0 0.55 0.02 1</ambient>
          <diffuse>1.0 0.62 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>0.15 0.17 0.075 -1.57079632679 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0008</iyy><iyz>0</iyz><izz>0.0014</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0.15 -0.17 0.075 -1.57079632679 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0008</iyy><iyz>0</iyz><izz>0.0014</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="caster_link">
      <pose>-0.16 0 0.035 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00008</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00008</iyy><iyz>0</iyz><izz>0.00008</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.15 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.045</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <sensor name="planar_lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>541</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619449</min_angle>
              <max_angle>2.35619449</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="camera_link">
      <pose relative_to="base_link">0.19 0 0.10 0 0 0</pose>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
      </visual>


      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <camera>
          <topic>camera/image_raw</topic>
          <gz_frame_id>camera_optical_frame</gz_frame_id>
          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <pose relative_to="left_wheel_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>20</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <pose relative_to="right_wheel_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>20</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.8</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
